# RegBridge configuration reference. Copy to .env for local Compose use only.
# Never commit a populated .env file or reuse these development credentials.

# Application
APP_NAME=regbridge-api                         # OPTIONAL: service name in health responses
APP_ENV=development                           # REQUIRED: development, test, or production
LOG_LEVEL=INFO                                # OPTIONAL: Python log level
APP_DEBUG=false                               # DEVELOPMENT ONLY: must be false in production
REGPACKS_PATH=../regpacks                     # REQUIRED: RegPack root (Compose sets /regpacks)

# Database
POSTGRES_DB=regbridge                         # DEVELOPMENT/COMPOSE: database name
POSTGRES_USER=regbridge                       # DEVELOPMENT/COMPOSE: bootstrap user
POSTGRES_PASSWORD=regbridge-local-only        # PRODUCTION REQUIRED: inject a strong secret
DATABASE_URL=postgresql+psycopg://regbridge:regbridge-local-only@postgres:5432/regbridge # REQUIRED
DATABASE_SQL_ECHO=false                       # OPTIONAL: must be false in production
PERSISTENCE_ENABLED=true                      # REQUIRED: must be true in production

# Authentication
AUTH_ENABLED=false                            # DEVELOPMENT ONLY when false; production forces true
OIDC_ISSUER=https://identity.example.com      # REQUIRED when authentication is enabled
OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration # REQUIRED when enabled
OIDC_CLIENT_ID=replace-me                     # REQUIRED when enabled
OIDC_CLIENT_SECRET=                           # PRODUCTION REQUIRED for the confidential web client
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback # REQUIRED when enabled; HTTPS in production
FRONTEND_URL=http://localhost:5180            # REQUIRED: post-authentication destination
SESSION_EXPIRY_SECONDS=28800                  # OPTIONAL: server-side session lifetime
OIDC_TRANSACTION_EXPIRY_SECONDS=600           # OPTIONAL: login transaction lifetime
INVITATION_EXPIRY_HOURS=168                   # OPTIONAL: one-time invitation lifetime

# Security boundaries
APPLICATION_SECRET=development-only-change-me # PRODUCTION REQUIRED: random, at least 32 characters
CORS_ALLOWED_ORIGINS=http://localhost:5180    # REQUIRED: comma-separated exact origins
TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver # REQUIRED: Host allowlist
HTTPS_BOUNDARY=false                          # PRODUCTION REQUIRED: true behind verified TLS ingress
HSTS_MAX_AGE_SECONDS=31536000                 # OPTIONAL: production HSTS lifetime
TRUST_PROXY_HEADERS=false                     # OPTIONAL: true only behind trusted ingress
TRUSTED_PROXY_IPS=                            # REQUIRED when proxy headers are trusted
COOKIE_SECURE=false                           # PRODUCTION REQUIRED: true
COOKIE_SAMESITE=lax                           # OPTIONAL: lax or strict
SESSION_COOKIE_NAME=regbridge_session         # OPTIONAL: opaque session cookie name
OIDC_TRANSACTION_COOKIE_NAME=regbridge_oidc_transaction # OPTIONAL: login cookie name
CSRF_HEADER_NAME=X-CSRF-Token                 # OPTIONAL: frontend integration header
REQUEST_MAX_BODY_MB=24                        # OPTIONAL: whole-request ceiling
MAPPING_MAX_CHARACTERS=250000                 # OPTIONAL: mapping JSON ceiling
RATE_LIMIT_WINDOW_SECONDS=60                  # OPTIONAL: in-process rate window
RATE_LIMIT_AUTH_REQUESTS=30                   # OPTIONAL: per window/client
RATE_LIMIT_INVITATION_REQUESTS=30             # OPTIONAL: per window/client
RATE_LIMIT_EXPENSIVE_REQUESTS=60              # OPTIONAL: per window/client
GENERATION_MAX_CONCURRENCY=2                  # MAXIMUM 2: measured per-process generation ceiling
GENERATION_RETRY_AFTER_SECONDS=5              # OPTIONAL: Retry-After for rejected generation requests

# Regulatory processing limits (OPTIONAL)
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_ROWS=50000
IMPORT_MAX_COLUMNS=200
IMPORT_MAX_XLSX_SHEETS=20
IMPORT_MAX_XLSX_ZIP_ENTRIES=10000
IMPORT_MAX_XLSX_UNCOMPRESSED_MB=100
IMPORT_MAX_XLSX_COMPRESSION_RATIO=100
IMPORT_PREVIEW_ROWS=20
OUTPUT_MAX_FILE_SIZE_MB=20
PREFLIGHT_MAX_FINDINGS=500

# Frontend
VITE_API_BASE_URL=                            # DEVELOPMENT ONLY: blank uses the Vite proxy

# Deployment / operations
METRICS_ENABLED=true                          # OPTIONAL: internal /api/v1/metrics endpoint
PRODUCTION_FRONTEND_PORT=8088                 # OPTIONAL: loopback production Compose port
BACKEND_CPU_LIMIT=2.0                         # PRODUCTION DEFAULT: measured generation headroom
BACKEND_MEMORY_LIMIT=512m                     # PRODUCTION DEFAULT: hard container ceiling
BACKEND_MEMORY_RESERVATION=256m               # PRODUCTION DEFAULT: expected working set
POSTGRES_CPU_LIMIT=1.0                        # PRODUCTION DEFAULT: reference deployment budget
POSTGRES_MEMORY_LIMIT=512m                    # PRODUCTION DEFAULT: hard container ceiling
POSTGRES_MEMORY_RESERVATION=128m              # PRODUCTION DEFAULT: expected working set
FRONTEND_CPU_LIMIT=0.5                        # PRODUCTION DEFAULT: static nginx budget
FRONTEND_MEMORY_LIMIT=128m                    # PRODUCTION DEFAULT: hard container ceiling
FRONTEND_MEMORY_RESERVATION=64m               # PRODUCTION DEFAULT: expected working set
